// Dolby Atmos (DAX3 3.12) — AIDL effect stack ported from Xiaomi 15 (dada, HyperOS A16)
// shared_libs intentionally omitted: check_elf_files disabled and every dependency is
// installed via dolby.mk PRODUCT_PACKAGES or already present on the device. Listing the
// versioned AIDL -ndk interface libs here drags in conflicting frozen aidl versions.
// SPDX-License-Identifier: Apache-2.0

soong_namespace {
    // import the QTI audio-effect framework namespace so libdapdirect (our thin
    // AIDL Dolby effect) can use aidlaudioeffectserviceqti_defaults +
    // libaudioeffecthal_base_impl_static.
    imports: [
        "hardware/qcom-caf/sm8750",
    ],
}

cc_prebuilt_library_shared {
    name: "libhwdapaidl",
    owner: "xiaomi",
    strip: { none: true },
    relative_install_path: "soundfx",
    target: { android_arm64: { srcs: ["proprietary/lib64/soundfx/libhwdapaidl.so"] } },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libdlbvolaidl",
    owner: "xiaomi",
    strip: { none: true },
    relative_install_path: "soundfx",
    target: { android_arm64: { srcs: ["proprietary/lib64/soundfx/libdlbvolaidl.so"] } },
    compile_multilib: "64",
    check_elf_files: false,
    prefer: true,
    soc_specific: true,
}

